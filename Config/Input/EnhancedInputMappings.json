{
  "Description": "Project RealWorld - Enhanced Input Schema and Default Mapping Contexts",
  "InputActions": [
    {
      "Name": "IA_Move",
      "ValueType": "Axis2D",
      "Description": "2D Directional locomotion input (Forward/Backward, Left/Right)"
    },
    {
      "Name": "IA_Look",
      "ValueType": "Axis2D",
      "Description": "Gamepad analog stick camera control"
    },
    {
      "Name": "IA_LookMouse",
      "ValueType": "Axis2D",
      "Description": "Mouse 2D delta camera orbit"
    },
    {
      "Name": "IA_Jump",
      "ValueType": "Digital",
      "Description": "Jump off ground or vault initiation"
    },
    {
      "Name": "IA_Sprint",
      "ValueType": "Digital",
      "Description": "Engage high-speed sprint with stamina consumption"
    },
    {
      "Name": "IA_Crouch",
      "ValueType": "Digital",
      "Description": "Toggle crouch locomotion state"
    },
    {
      "Name": "IA_Interact",
      "ValueType": "Digital",
      "Description": "Trigger contextual interaction with focused world actor"
    },
    {
      "Name": "IA_Attack",
      "ValueType": "Digital",
      "Description": "Fire weapon or execute melee attack"
    },
    {
      "Name": "IA_Aim",
      "ValueType": "Digital",
      "Description": "Aim down sights with over-the-shoulder zoom"
    },
    {
      "Name": "IA_Reload",
      "ValueType": "Digital",
      "Description": "Reload current weapon magazine"
    },
    {
      "Name": "IA_Vault",
      "ValueType": "Digital",
      "Description": "Trigger procedural obstacle mantle/vault trace"
    },
    {
      "Name": "IA_EnterVehicle",
      "ValueType": "Digital",
      "Description": "Enter nearby interactable vehicle"
    },
    {
      "Name": "IA_ExitVehicle",
      "ValueType": "Digital",
      "Description": "Exit possessed vehicle"
    }
  ],
  "MappingContexts": {
    "IMC_OnFoot": {
      "Priority": 0,
      "Mappings": [
        {
          "Action": "IA_Move",
          "Key": "W",
          "Modifiers": ["SwizzleAxis(YXZ)"]
        },
        {
          "Action": "IA_Move",
          "Key": "S",
          "Modifiers": ["SwizzleAxis(YXZ)", "Negate"]
        },
        {
          "Action": "IA_Move",
          "Key": "A",
          "Modifiers": ["Negate"]
        },
        {
          "Action": "IA_Move",
          "Key": "D",
          "Modifiers": []
        },
        {
          "Action": "IA_Move",
          "Key": "Gamepad_LeftThumbstick",
          "Modifiers": ["DeadZone(0.2)"]
        },
        {
          "Action": "IA_LookMouse",
          "Key": "Mouse2D",
          "Modifiers": ["Negate(Y)"]
        },
        {
          "Action": "IA_Look",
          "Key": "Gamepad_RightThumbstick",
          "Modifiers": ["DeadZone(0.2)"]
        },
        {
          "Action": "IA_Jump",
          "Key": "SpaceBar",
          "Triggers": ["Pressed"]
        },
        {
          "Action": "IA_Sprint",
          "Key": "LeftShift",
          "Triggers": ["Down"]
        },
        {
          "Action": "IA_Crouch",
          "Key": "LeftControl",
          "Triggers": ["Pressed"]
        },
        {
          "Action": "IA_Interact",
          "Key": "E",
          "Triggers": ["Pressed"]
        },
        {
          "Action": "IA_Attack",
          "Key": "LeftMouseButton",
          "Triggers": ["Pressed"]
        },
        {
          "Action": "IA_Aim",
          "Key": "RightMouseButton",
          "Triggers": ["Down"]
        },
        {
          "Action": "IA_Reload",
          "Key": "R",
          "Triggers": ["Pressed"]
        },
        {
          "Action": "IA_Vault",
          "Key": "SpaceBar",
          "Triggers": ["Pressed"]
        },
        {
          "Action": "IA_EnterVehicle",
          "Key": "F",
          "Triggers": ["Pressed"]
        }
      ]
    },
    "IMC_Vehicle": {
      "Priority": 1,
      "Mappings": [
        {
          "Action": "IA_Move",
          "Key": "W",
          "Description": "Throttle"
        },
        {
          "Action": "IA_Move",
          "Key": "S",
          "Description": "Brake / Reverse"
        },
        {
          "Action": "IA_Move",
          "Key": "A",
          "Description": "Steer Left"
        },
        {
          "Action": "IA_Move",
          "Key": "D",
          "Description": "Steer Right"
        },
        {
          "Action": "IA_Jump",
          "Key": "SpaceBar",
          "Description": "Handbrake"
        },
        {
          "Action": "IA_LookMouse",
          "Key": "Mouse2D",
          "Description": "Free-look vehicle camera"
        },
        {
          "Action": "IA_ExitVehicle",
          "Key": "F",
          "Triggers": ["Pressed"]
        }
      ]
    }
  }
}
